PORT=3000
CORS_ORIGIN=http://localhost:3002

DB_HOST=localhost
DB_PORT=5432
DB_USER=hobbyhub
DB_PASSWORD=hobbyhub
DB_NAME=hobbyhub

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# S3-совместимое хранилище (AWS S3 / MinIO / Yandex Object Storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hobbyhub
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/hobbyhub

# Yandex Geocoder (FR-3.3) — https://developer.tech.yandex.ru/services/
YANDEX_GEOCODER_API_KEY=change-me

# SMTP для писем (подтверждение email, сброс пароля). Если не задано —
# письма только логируются, реально не отправляются (см. mail.service.ts).
SMTP_HOST=smtp.timeweb.ru
# 587 (STARTTLS), не 465 — 465 у smtp.timeweb.ru зависал на TLS-хендшейке.
SMTP_PORT=587
SMTP_USER=support@hobbyhub.ru
SMTP_PASSWORD=change-me
MAIL_FROM=support@hobbyhub.ru

# Платежи (Фаза 4) — мок-провайдер, эмулирующий ЮKassa «Безопасная сделка»
FRONTEND_URL=http://localhost:3002
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_COMMISSION_PERCENT=10
PAYMENT_ESCROW_RELEASE_HOURS=48
PAYMENT_TIMEOUT_MINUTES=30
